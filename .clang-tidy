# AEGIS static analysis (AEGIS-227).
#
# The enabled families are the ones that catch the failures this project cannot
# tolerate: undefined behaviour, lifetime and ownership mistakes in the
# deterministic cores, and accidental narrowing in price/quantity arithmetic.
#
# Disabled with reason:
#   modernize-use-trailing-return-type ....... style-only, and noisy on headers.
#   readability-identifier-length ............ conflicts with idiomatic i/j/n.
#   misc-non-private-member-variables ........ value types are used deliberately.
#   *-magic-numbers .......................... fires on test fixtures.
#   bugprone-easily-swappable-parameters ..... fires on any signature with two
#     parameters of one type; avoiding it would mean a wrapper type per string
#     argument. Domain confusions that actually matter (clock domains, price vs
#     quantity) get real strong types instead — see cpp/common/time.hpp.
#   readability-braces-around-statements ..... the Google style this project
#     formats to permits a single-statement if on one line.
#   misc-include-cleaner ..................... flags headers the language
#     requires but the source does not name, such as <compare> for a
#     defaulted three-way comparison.
#   portability-avoid-pragma-once ............ every compiler in
#     docs/ENVIRONMENT.md implements #pragma once and the codebase uses it
#     uniformly; include guards would add noise without adding portability.
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -misc-non-private-member-variables-in-classes,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-magic-numbers,
  -portability-avoid-pragma-once,
  -misc-include-cleaner,
  -readability-braces-around-statements,
  -bugprone-easily-swappable-parameters

WarningsAsErrors: '*'
HeaderFilterRegex: '(cpp)/.*'
FormatStyle: file

CheckOptions:
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ConstexprVariableCase
    value: CamelCase
  - key: readability-identifier-naming.ConstexprVariablePrefix
    value: k
