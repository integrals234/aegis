{
  "_comment": "M5 risk limits (AEGIS-121..134). JSON, not YAML: the CLI (cpp/participant/app/participant_run_main.cpp) loads this with nlohmann::json, the same library already used for every other participant-app fixture/config -- adding a C++ YAML dependency would require editing cpp/CMakeLists.txt or the root CMakeLists.txt, neither of which is in M5's approved scope (m5-build-wiring covers only cpp/participant/CMakeLists.txt and cpp/participant/app/CMakeLists.txt). Deliberately small, deterministic values sized for the committed calendar-spread demo (near=2001, far=2002), not a claim of production-suitable sizing (docs/LIMITATIONS.md).",
  "base_currency": "USD",
  "order_quantity_limits": {
    "2001": {
      "max_order_quantity_units": 50,
      "resize_on_breach": true
    },
    "2002": {
      "max_order_quantity_units": 50,
      "resize_on_breach": true
    }
  },
  "position_limits": {
    "2001": {
      "max_long_units": 200,
      "max_short_units": 200
    },
    "2002": {
      "max_long_units": 200,
      "max_short_units": 200
    }
  },
  "max_order_notional_units": 50000000,
  "max_portfolio_notional_units": 200000000,
  "instruments": {
    "2001": {
      "multiplier_units": 50,
