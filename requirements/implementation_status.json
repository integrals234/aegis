{
  "project": "AEGIS",
  "active_milestone": "M0",
  "requirements": {
    "AEGIS-001": {
      "status": "implemented",
      "implementation": [
        "tools/check_frozen.py",
        ".claude/hooks/protect_spec.py",
        "scripts/git-hooks/pre-commit"
      ],
      "tests": [
        "tests/unit/test_frozen_integrity.py",
        "tests/unit/test_protect_spec_hook.py"
      ],
      "reports": [],
      "notes": "Hash manifest plus branch-diff gate, hardened fail-closed hook covering frozen_hashes.json, pre-commit and CI. The hook is defence in depth; docs/LIMITATIONS.md records that it cannot see shell-mediated writes."
    },
    "AEGIS-002": {
      "status": "implemented",
      "implementation": [
        "tools/audit_requirements.py",
        "tools/generate_traceability.py"
      ],
      "tests": [
        "tests/unit/test_audit_requirements.py"
      ],
      "reports": [
        "docs/TRACEABILITY_MATRIX.md"
      ],
      "notes": "Auditor refactored to run_audit(req_path, status_path, root) so it is testable against fixture trees; duplicate JSON keys, duplicate IDs, missing and orphan entries all detected. Matrix generated and drift-checked in CI."
    },
    "AEGIS-003": {
      "status": "implemented",
      "implementation": [
        "tools/audit_requirements.py",
        "tools/update_status.py",
        "tools/generate_deferred_register.py"
      ],
      "tests": [
        "tests/unit/test_evidence_rules.py"
      ],
      "reports": [
        "docs/DEFERRED_VERIFICATION.md"
      ],
      "notes": "A path that exists is no longer evidence: directories, empty files, .gitkeep and TODO-only files are rejected. 'verified' requires an audit record and is hard-blocked while an obligation is open."
    },
    "AEGIS-004": {
      "status": "implemented",
      "implementation": [
        "tools/check_architecture.py",
        "configs/architecture_rules.yaml"
      ],
      "tests": [
        "tests/unit/test_check_architecture.py"
      ],
      "reports": [],
      "notes": "Checker enforces include, import, namespace and CMake link edges over the real tree, with a committed counter-example tree exercising every rule.",
      "verification_blocked_until": "M1",
      "residual": "No exchange book (M1) or strategy/risk/OMS code (M3) exists yet for the participant-pipeline rules to constrain; the rules currently bind only the substrate layers."
    },
    "AEGIS-005": {
      "status": "implemented",
      "implementation": [
        "tools/determinism_check.py",
        "python/common/determinism.py"
      ],
      "tests": [
        "tests/replay/test_determinism_harness.py"
      ],
      "reports": [
        "experiments/evidence/AEGIS-005/summary.json"
      ],
      "notes": "Run-twice-across-processes harness with a committed nondeterministic counter-example it must flag.",
      "verification_blocked_until": "M1",
      "residual": "Canonical output covers platform records only. M0 shows the harness detects nondeterminism; it is not a claim that AEGIS is deterministic. Real event input arrives with M1, and this is a hard gate before M8 optimization begins."
    },
    "AEGIS-006": {
      "status": "implemented",
      "implementation": [
        "tools/check_claims.py",
        "configs/claims_policy.yaml"
      ],
      "tests": [
        "tests/unit/test_check_claims.py"
      ],
      "reports": [],
      "notes": "Forbidden phrasing from the frozen CV policy plus numbers adjacent to performance or trading units without a resolvable evidence marker. Exclusions are per-path with a reason and can be narrowed to named phrases."
    },
    "AEGIS-007": {
      "status": "implemented",
      "implementation": [
        "tools/check_scope.py",
        "configs/milestone_scope.yaml",
        "docs/BUILD_STATE.md"
      ],
      "tests": [
        "tests/unit/test_scope_guard.py"
      ],
      "reports": [],
      "notes": "Both halves of the acceptance: BUILD_STATE names exactly one active milestone, and the branch diff is checked against that milestone's allowed and denied paths."
    },
    "AEGIS-008": {
      "status": "implemented",
      "implementation": [
        "tools/check_adrs.py",
        "adr/0001-platform-architecture.md"
      ],
      "tests": [
        "tests/unit/test_check_adrs.py"
      ],
      "reports": [],
      "notes": "Structure, status, milestone and requirement IDs validated; dangling ADR references detected; and the linkage half enforced, so an architecture change on a branch must cite an ADR."
    },
    "AEGIS-009": {
      "status": "implemented",
      "implementation": [
        "scripts/check_environment.sh",
        "tools/capture_environment.py",
        "docker/Dockerfile.dev",
        "docs/ENVIRONMENT.md"
      ],
      "tests": [],
      "reports": [
        "experiments/evidence/AEGIS-009/environment.json"
      ],
      "notes": "Version-checking environment script, lockfile drift detection, mechanical environment capture including virtualisation status, and a container definition.",
      "verification_blocked_until": "M1",
      "residual": "docker/Dockerfile.dev has never been built: Docker Desktop WSL integration is disabled on the development host, and no CI run has executed. A clean-machine transcript from a container or CI runner is still owed."
    },
    "AEGIS-010": {
      "status": "implemented",
      "implementation": [
        "tools/scan_secrets.py",
        "configs/secret_scan_allowlist.json",
        ".claude/settings.json"
      ],
      "tests": [
        "tests/unit/test_scan_secrets.py",
        "tests/unit/test_settings_deny_rules.py"
      ],
      "reports": [],
      "notes": "Scanner covers worktree, index and history. The settings test is a configuration assertion, not a behavioural proof; the behavioural control is the scanner."
    },
